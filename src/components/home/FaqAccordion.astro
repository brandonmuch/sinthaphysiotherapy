---
import { getEntry } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";
import { icons } from "../../lib/icons";

const entry = await getEntry("home", "faq");
const data = entry!.data as {
  eyebrow: string;
  heading: string;
  items: Array<{ question: string; answer: string }>;
};
---

<section class="section section--wash faq">
  <div class="container faq__container">
    <SectionHeading eyebrow={data.eyebrow} heading={data.heading} />

    <div class="faq__list" data-reveal>
      {
        data.items.map((item, i) => (
          <details class="faq-item" name="faq" open={i === 0}>
            <summary>
              <span>{item.question}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons["chevron-down"]} />
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__container {
    max-width: 48rem;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--hairline);
  }

  .faq-item {
    border-bottom: 1px solid var(--hairline);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-md);
    color: var(--plum-900);
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--terracotta-text);
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .faq-item[open] summary svg {
    transform: rotate(180deg);
  }

  .faq-item p {
    padding-bottom: var(--space-4);
    color: var(--stone);
    max-width: 60ch;
  }
</style>
