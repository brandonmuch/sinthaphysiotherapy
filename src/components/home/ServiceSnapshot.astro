---
import { getEntry } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";
import { icons, defaultIconKey } from "../../lib/icons";

const entry = await getEntry("home", "service-snapshot");
const data = entry!.data as {
  eyebrow: string;
  heading: string;
  description: string;
  cards: Array<{ title: string; description: string; icon: string }>;
};
---

<section class="section snapshot" id="services">
  <div class="container">
    <SectionHeading eyebrow={data.eyebrow} heading={data.heading} description={data.description} />

    <div class="grid grid--3">
      {
        data.cards.map((item, i) => (
          <div class="snapshot-card card" data-reveal style={`transition-delay: ${(i % 3) * 80}ms`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[item.icon] ?? icons[defaultIconKey]} />
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))
      }
    </div>

    <a href="/services" class="btn btn--ghost snapshot__cta">See all services</a>
  </div>
</section>

<style>
  .snapshot-card {
    padding: var(--space-5);
  }

  .snapshot-card svg {
    width: 28px;
    height: 28px;
    color: var(--terracotta-text);
  }

  .snapshot-card h3 {
    margin-top: var(--space-4);
    font-size: var(--text-md);
    color: var(--plum-900);
  }

  .snapshot-card p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--stone);
  }

  .snapshot__cta {
    margin-top: var(--space-6);
  }
</style>
