---
import { getEntry } from "astro:content";

const entry = await getEntry("home", "hero");
const data = entry!.data as {
  eyebrow: string;
  headline: string;
  subheadline: string;
  ctaText: string;
  ctaHref: string;
  secondaryCtaText: string;
  secondaryCtaHref: string;
  image: string;
  imageAlt: string;
};
---

<section class="hero">
  <div class="hero__media">
    <img src={data.image} alt={data.imageAlt} />
  </div>

  <div class="container hero__content">
    <p class="hero__eyebrow">
      <span class="hero__eyebrow-rule" aria-hidden="true"></span>
      {data.eyebrow}
    </p>
    <h1 class="hero__headline">{data.headline}</h1>
    <p class="hero__subheadline">{data.subheadline}</p>
    <div class="hero__actions btn-group">
      <a href={data.ctaHref} target="_blank" rel="noopener" class="btn btn--primary">{data.ctaText}</a>
      <a href={data.secondaryCtaHref} class="btn btn--secondary">{data.secondaryCtaText}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    color: var(--white);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(42, 27, 61, 0.25) 0%, rgba(42, 27, 61, 0.55) 55%, rgba(42, 27, 61, 0.95) 100%),
      linear-gradient(90deg, rgba(42, 27, 61, 0.6) 0%, rgba(42, 27, 61, 0) 60%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: var(--space-7);
    padding-bottom: var(--space-8);
    max-width: 42rem;
    margin-inline: 0 auto;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--terracotta);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .hero__eyebrow-rule {
    display: inline-block;
    width: 32px;
    height: 2px;
    background: var(--terracotta);
  }

  .hero__headline {
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--white);
    margin-top: var(--space-4);
  }

  .hero__subheadline {
    margin-top: var(--space-4);
    font-size: var(--text-md);
    color: #e9e2ec;
    max-width: 34rem;
  }

  .hero__actions {
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) {
    .hero__headline {
      font-size: var(--text-4xl);
    }
  }
</style>
