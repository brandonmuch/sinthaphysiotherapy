---
import { getEntry } from "astro:content";

const entry = await getEntry("home", "cta");
const data = entry!.data as {
  heading: string;
  buttonText: string;
  buttonHref: string;
  image: string;
  imageAlt: string;
};
---

<section class="cta-banner">
  <img src={data.image} alt={data.imageAlt} class="cta-banner__media" loading="lazy" />
  <div class="container cta-banner__content" data-reveal>
    <h2>{data.heading}</h2>
    <a href={data.buttonHref} target="_blank" rel="noopener" class="btn btn--primary">{data.buttonText}</a>
  </div>
</section>

<style>
  .cta-banner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 22rem;
    overflow: hidden;
    color: var(--white);
  }

  .cta-banner__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(42, 27, 61, 0.72);
  }

  .cta-banner__content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .cta-banner__content h2 {
    font-size: var(--text-2xl);
    max-width: 24ch;
  }
</style>
