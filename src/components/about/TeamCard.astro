---
import { toParagraphs } from "../../lib/renderText";

interface Props {
  name: string;
  credentials: string[];
  specialties: string[];
  photo: string;
  bio: string;
  delay?: number;
}

const { name, credentials, specialties, photo, bio, delay = 0 } = Astro.props;
const paragraphs = toParagraphs(bio);
---

<article class="team-card card" data-reveal style={`transition-delay: ${delay}ms`}>
  <img src={photo} alt={`Portrait of ${name}`} loading="lazy" />
  <div class="team-card__body">
    <h3>{name}</h3>
    <p class="team-card__credentials">{credentials.join(" · ")}</p>
    <ul class="team-card__specialties">
      {specialties.map((s) => <li>{s}</li>)}
    </ul>
    {paragraphs.map((p) => <p class="team-card__bio">{p}</p>)}
  </div>
</article>

<style>
  .team-card {
    overflow: hidden;
  }

  .team-card img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .team-card__body {
    padding: var(--space-5);
  }

  .team-card__body h3 {
    font-size: var(--text-lg);
    color: var(--plum-900);
  }

  .team-card__credentials {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--stone);
  }

  .team-card__specialties {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-top: var(--space-3);
  }

  .team-card__specialties li {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--terracotta-text);
    background: var(--blush);
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-btn);
  }

  .team-card__bio {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--stone);
  }

  .team-card__bio + .team-card__bio {
    margin-top: var(--space-2);
  }
</style>
