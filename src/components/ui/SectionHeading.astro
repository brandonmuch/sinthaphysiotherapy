---
interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  id?: string;
  light?: boolean;
}

const { eyebrow, heading, description, id, light } = Astro.props;
---

<div class:list={["section-heading", { "section-heading--light": light }]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{heading}</h2>
  {description && <p>{description}</p>}
</div>
