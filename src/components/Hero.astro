---
const heroHeadline = "Empower Movement. Enhance Life.";
---

<section class="relative h-[100svh] w-full flex items-end pb-24 px-6 overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img 
      src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?q=80&w=2836&auto=format&fit=crop" 
      alt="Sintha Physiotherapy Clinic" 
      class="image-cinematic opacity-40"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/40 to-transparent"></div>
  </div>

  <!-- Headline -->
  <div class="relative z-10 max-w-screen-2xl mx-auto w-full">
    <p class="text-xs font-mono tracking-widest text-lilac mb-6 uppercase overflow-hidden">
      <span class="block hero-eyebrow translate-y-full">Fourways · Johannesburg</span>
    </p>
    <h1 class="font-serif text-display-lg text-cream leading-[0.85] tracking-tighter max-w-4xl text-balance">
      <span class="block overflow-hidden"><span class="block hero-line translate-y-full">Empower</span></span>
      <span class="block overflow-hidden"><span class="block hero-line translate-y-full">Movement.</span></span>
      <span class="block overflow-hidden"><span class="block hero-line text-lilac translate-y-full">Enhance Life.</span></span>
    </h1>
    <div class="mt-12 flex items-center gap-6 opacity-0 hero-cta">
      <a href="#contact" class="btn-primary">Book an Assessment</a>
      <a href="#philosophy" class="text-sm text-cream/60 hover:text-cream transition-colors">Discover our approach ↓</a>
    </div>
  </div>
</section>