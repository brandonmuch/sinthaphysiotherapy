---
import { getEntry } from "astro:content";

const settingsEntry = await getEntry("siteSettings", "main");
const whatsapp = settingsEntry?.data.whatsapp ?? "27670721908";
const message = "Hi Sintha Physiotherapy, I'd like to find out more.";
const href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(message)}`;
---

<a href={href} target="_blank" rel="noopener" class="whatsapp-fab" aria-label="Chat with us on WhatsApp">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.2h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.06h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.29c0-4.53 3.69-8.22 8.24-8.22 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.53-3.69 8.15-8.23 8.15Zm4.51-6.16c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.96-.14.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.24-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.24.25-.4.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42-.14-.01-.31-.01-.47-.01a.9.9 0 0 0-.65.3c-.23.24-.86.84-.86 2.05s.88 2.38 1 2.54c.12.16 1.73 2.64 4.19 3.7.58.25 1.04.4 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.46-.6 1.66-1.17.21-.58.21-1.08.14-1.18-.06-.1-.22-.16-.47-.28Z"
    />
  </svg>
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: var(--white);
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.35);
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .whatsapp-fab:hover,
  .whatsapp-fab:focus-visible {
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      transition: none;
    }
  }
</style>
