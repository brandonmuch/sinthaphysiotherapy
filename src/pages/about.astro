---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import TeamCard from "../components/about/TeamCard.astro";
import { toParagraphs } from "../lib/renderText";
import { icons } from "../lib/icons";

const philosophy = await getEntry("about", "philosophy");
const teamIntro = await getEntry("about", "team-intro");
const affiliatedIntro = await getEntry("about", "affiliated-intro");

const team = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
const professionals = (await getCollection("affiliatedProfessionals")).sort(
  (a, b) => a.data.order - b.data.order
);

const philosophyParagraphs = toParagraphs(philosophy!.data.body as string);
---

<BaseLayout
  title="About"
  description="Meet the Sintha Physiotherapy team and the affiliated specialists we work with across Life Fourways Hospital, Fourways, Johannesburg."
>
  <section class="section section--plum philosophy">
    <div class="container philosophy__grid">
      <div data-reveal>
        <p class="eyebrow">{philosophy!.data.eyebrow as string}</p>
        <h1>{philosophy!.data.heading as string}</h1>
        {philosophyParagraphs.map((p) => <p class="philosophy__body">{p}</p>)}
        <p class="philosophy__closing">{philosophy!.data.closingLine as string}</p>
      </div>
      <img src={philosophy!.data.image as string} alt={philosophy!.data.imageAlt as string} class="philosophy__image" loading="lazy" />
    </div>
  </section>

  <section class="section team">
    <div class="container">
      <SectionHeading eyebrow={teamIntro!.data.eyebrow as string} heading={teamIntro!.data.heading as string} />
      <div class="grid grid--2">
        {
          team.map((member, i) => (
            <TeamCard
              name={member.data.name}
              credentials={member.data.credentials}
              specialties={member.data.specialties}
              photo={member.data.photo}
              bio={member.data.bio}
              delay={(i % 2) * 80}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--wash affiliated">
    <div class="container">
      <SectionHeading
        eyebrow={affiliatedIntro!.data.eyebrow as string}
        heading={affiliatedIntro!.data.heading as string}
        description={affiliatedIntro!.data.description as string}
      />
      <ul class="affiliated__list">
        {
          professionals.map((doctor, i) => (
            <li class="affiliated-card card" data-reveal style={`transition-delay: ${i * 80}ms`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.stethoscope} />
              <div>
                <h3>{doctor.data.name}</h3>
                <p class="affiliated-card__specialty">{doctor.data.specialty}</p>
                <p class="affiliated-card__location">{doctor.data.location}</p>
                <a href={`tel:${doctor.data.phone.replace(/\s+/g, "")}`}>{doctor.data.phone}</a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .philosophy__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .philosophy h1 {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
    max-width: 20ch;
  }

  .philosophy__body {
    margin-top: var(--space-4);
    color: #d8c9de;
    max-width: 52ch;
  }

  .philosophy__closing {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--terracotta);
  }

  .philosophy__image {
    border-radius: var(--radius-lg);
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .affiliated__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .affiliated-card {
    padding: var(--space-5);
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .affiliated-card svg {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: var(--terracotta-text);
    margin-top: 2px;
  }

  .affiliated-card h3 {
    font-size: var(--text-md);
    color: var(--plum-900);
  }

  .affiliated-card__specialty {
    color: var(--terracotta-text);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-top: var(--space-1);
  }

  .affiliated-card__location {
    color: var(--stone);
    font-size: var(--text-sm);
    margin-top: var(--space-1);
  }

  .affiliated-card a {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--plum-900);
    text-decoration: none;
  }

  .affiliated-card a:hover,
  .affiliated-card a:focus-visible {
    color: var(--terracotta-text);
  }

  @media (min-width: 860px) {
    .philosophy__grid {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-8);
    }
  }

  @media (min-width: 640px) {
    .affiliated__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
