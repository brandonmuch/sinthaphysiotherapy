---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { icons } from "../lib/icons";

const settingsEntry = await getEntry("siteSettings", "main");
const settings = settingsEntry!.data;
const bookingHref = `https://wa.me/${settings.whatsapp}`;
---

<BaseLayout
  title="Contact"
  description="Book an assessment at Sintha Physiotherapy, Life Fourways Hospital, Fourways, Johannesburg. Contact us by form, WhatsApp, or phone."
>
  <section class="section section--plum contact-hero">
    <div class="container">
      <p class="eyebrow">Get in touch</p>
      <h1>Contact us</h1>
      <p class="contact-hero__sub">All sessions are by appointment. Walk-ins are welcome, subject to availability.</p>
    </div>
  </section>

  <section class="section contact">
    <div class="container contact__grid">
      <div class="contact__details" data-reveal>
        <h2>Sintha Physiotherapy</h2>

        <dl>
          <div class="contact__row">
            <dt>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons["map-pin"]} />
              <span class="visually-hidden">Address</span>
            </dt>
            <dd>{settings.addressLine1}<br />{settings.addressLine2}</dd>
          </div>
          <div class="contact__row">
            <dt>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.phone} />
              <span class="visually-hidden">Phone</span>
            </dt>
            <dd><a href={`tel:${settings.phone.replace(/\s+/g, "")}`}>{settings.phone}</a></dd>
          </div>
          <div class="contact__row">
            <dt>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.mail} />
              <span class="visually-hidden">Email</span>
            </dt>
            <dd><a href={`mailto:${settings.email}`}>{settings.email}</a></dd>
          </div>
          <div class="contact__row">
            <dt>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.clock} />
              <span class="visually-hidden">Hours</span>
            </dt>
            <dd>{settings.hours}<br />{settings.hoursNote}</dd>
          </div>
        </dl>

        <a href={bookingHref} target="_blank" rel="noopener" class="btn btn--primary contact__whatsapp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons["message-circle"]} />
          Book via WhatsApp
        </a>
      </div>

      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="contact-form card" data-reveal>
        <input type="hidden" name="form-name" value="contact" />
        <p class="visually-hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <h2>Send us a message</h2>

        <div class="form-row form-row--2col">
          <div class="form-field">
            <label for="firstName">First name</label>
            <input type="text" id="firstName" name="firstName" autocomplete="given-name" required />
          </div>
          <div class="form-field">
            <label for="lastName">Last name</label>
            <input type="text" id="lastName" name="lastName" autocomplete="family-name" required />
          </div>
        </div>

        <div class="form-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>

        <div class="form-field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="btn btn--primary">Submit</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero h1 {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
  }

  .contact-hero__sub {
    margin-top: var(--space-3);
    color: #d8c9de;
    max-width: 46ch;
  }

  .contact__grid {
    display: grid;
    gap: var(--space-7);
  }

  .contact__details h2 {
    font-size: var(--text-2xl);
    color: var(--plum-900);
  }

  .contact__details dl {
    margin-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__row {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .contact__row dt svg {
    width: 22px;
    height: 22px;
    color: var(--terracotta-text);
    margin-top: 2px;
  }

  .contact__row dd {
    margin: 0;
    color: var(--charcoal);
  }

  .contact__row dd a {
    color: inherit;
    text-decoration: none;
  }

  .contact__row dd a:hover,
  .contact__row dd a:focus-visible {
    color: var(--terracotta-text);
  }

  .contact__whatsapp {
    margin-top: var(--space-6);
  }

  .contact-form {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-form h2 {
    font-size: var(--text-xl);
    color: var(--plum-900);
  }

  .form-row--2col {
    display: grid;
    gap: var(--space-4);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-field label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--plum-900);
  }

  .form-field input,
  .form-field textarea {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.9rem;
    font-size: var(--text-base);
    color: var(--charcoal);
    background: var(--white);
  }

  .form-field input:focus-visible,
  .form-field textarea:focus-visible {
    outline: 2px solid var(--terracotta-text);
    outline-offset: 1px;
  }

  .contact-form button {
    margin-top: var(--space-2);
    align-self: flex-start;
  }

  @media (min-width: 640px) {
    .form-row--2col {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .contact__grid {
      grid-template-columns: 2fr 3fr;
    }
  }
</style>
