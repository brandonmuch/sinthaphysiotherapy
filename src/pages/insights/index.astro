---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/insights/ArticleCard.astro";
import { icons } from "../../lib/icons";

const allArticles = (await getCollection("insights")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const topicTags = [
  "Respiratory",
  "Paediatrics",
  "Geriatrics",
  "Neuro Rehab",
  "Postoperative Recovery",
  "Cardiac Rehab",
  "General Wellness",
];
---

<BaseLayout
  title="Insights"
  description="Insights and resources on recovery, respiratory care, paediatric physiotherapy and healthy movement from Sintha Physiotherapy."
>
  <section class="section section--plum insights-hero">
    <div class="container">
      <p class="eyebrow">Insights & Resources</p>
      <h1>Practical guidance for your recovery journey</h1>
      <p class="insights-hero__intro">
        Straightforward advice on breathing, movement and rehabilitation, from our team of physiotherapists.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="topic-tags">
        {topicTags.map((tag) => <li>{tag}</li>)}
      </ul>

      {
        allArticles.length === 0 ? (
          <div class="empty-state" data-reveal>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons["book-open"] ?? icons.sparkles} />
            <h2>New articles are on the way</h2>
            <p>We're preparing our first posts on recovery, respiratory care and healthy movement. Check back soon, or follow us on WhatsApp for updates.</p>
          </div>
        ) : (
          <div class="grid grid--3">
            {allArticles.map((article) => (
              <ArticleCard
                slug={article.id}
                title={article.data.title}
                category={article.data.category}
                date={article.data.date}
                excerpt={article.data.excerpt}
                image={article.data.image}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .insights-hero h1 {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
    max-width: 22ch;
  }

  .insights-hero__intro {
    margin-top: var(--space-4);
    color: #d8c9de;
    max-width: 50ch;
  }

  .topic-tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .topic-tags li {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--plum-900);
    background: var(--blush);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-btn);
  }

  .empty-state {
    text-align: center;
    max-width: 32rem;
    margin-inline: auto;
    padding-block: var(--space-8);
  }

  .empty-state svg {
    width: 40px;
    height: 40px;
    color: var(--terracotta-text);
    margin-inline: auto;
  }

  .empty-state h2 {
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    color: var(--plum-900);
  }

  .empty-state p {
    margin-top: var(--space-3);
    color: var(--stone);
  }

  @media (min-width: 768px) {
    .insights-hero h1 {
      font-size: var(--text-4xl);
    }
  }
</style>
