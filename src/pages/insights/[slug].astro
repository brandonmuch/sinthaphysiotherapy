---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("insights");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const formattedDate = article.data.date.toLocaleDateString("en-ZA", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={article.data.title} description={article.data.excerpt}>
  <article class="section post">
    <div class="container post__container">
      <a href="/insights" class="post__back">&larr; Back to Insights</a>
      <p class="eyebrow">{article.data.category}</p>
      <h1>{article.data.title}</h1>
      <p class="post__date">{formattedDate}</p>
      <img src={article.data.image} alt="" class="post__image" />
      <div class="post__content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post__container {
    max-width: 48rem;
  }

  .post__back {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--terracotta-text);
    text-decoration: none;
    margin-bottom: var(--space-5);
  }

  .post h1 {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
    color: var(--plum-900);
  }

  .post__date {
    margin-top: var(--space-3);
    color: var(--stone);
    font-size: var(--text-sm);
  }

  .post__image {
    margin-top: var(--space-6);
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .post__content {
    margin-top: var(--space-6);
    color: var(--charcoal);
  }

  .post__content :global(p) {
    margin-top: var(--space-4);
    max-width: 68ch;
  }

  .post__content :global(h2) {
    margin-top: var(--space-6);
    font-size: var(--text-xl);
    color: var(--plum-900);
  }
</style>
